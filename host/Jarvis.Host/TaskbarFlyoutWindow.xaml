<Window x:Class="Jarvis.Host.TaskbarFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS Task Switcher"
        Width="520"
        Height="220"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="#020912"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Closed="OnClosed">
  <Border BorderBrush="#166EAA"
          BorderThickness="1"
          Background="#F5020912"
          CornerRadius="5"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="14,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="3"
                Height="14"
                Margin="0,0,10,0"
                Background="#22CFFF"
                VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect Color="#22CFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
          </Border.Effect>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText"
                     Foreground="#D7F2FF"
                     FontFamily="Bahnschrift"
                     FontSize="11"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="MetaText"
                     Margin="10,0,0,0"
                     Foreground="#6689A3"
                     FontFamily="Consolas"
                     FontSize="9" />
        </StackPanel>
        <Button Grid.Column="2"
                Width="30"
                Height="28"
                Content="×"
                Foreground="#77BDE8"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Segoe UI"
                FontSize="17"
                ToolTip="Close preview"
                Click="OnCloseFlyoutClick" />
      </Grid>

      <Border Grid.Row="0"
              Height="1"
              Margin="14,39,14,0"
              Background="#163A55"
              VerticalAlignment="Top" />

      <WrapPanel x:Name="CardsPanel"
                 Grid.Row="1"
                 Margin="8,7,8,9"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top" />
    </Grid>
  </Border>
</Window>
